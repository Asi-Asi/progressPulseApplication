{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": { "@/*": ["./*"] },
        "jsx": "react-jsx",
        "allowJs": true,
        "checkJs": false
    },
    "include": [
        "app",
        "expo-env.d.ts",
        "nativewind-env.d.ts",
        "**/*.js",
        "**/*.jsx"
    ],
    "exclude": ["node_modules", ".expo"]
}
