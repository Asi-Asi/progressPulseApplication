### יצירת סשן להיום מתוך תוכנית (fromPlanId + planDay)
POST https://progresspulseapplication.onrender.com/api/workouts/sessions
Authorization: Bearer REPLACE_WITH_YOUR_JWT
Content-Type: application/json

{
  "fromPlanId": "REPLACE_PLAN_ID",
  "planDay": 1
}

###
# תצוגת סשן: planned + maxByExercise
GET https://progresspulseapplication.onrender.com/api/workouts/sessions/REPLACE_SESSION_ID/view
Authorization: Bearer REPLACE_WITH_YOUR_JWT

###
# הוספת תרגיל לסשן (אם לא קיים כבר ב-exercises)
POST https://progresspulseapplication.onrender.com/api/workouts/sessions/REPLACE_SESSION_ID/exercises
Authorization: Bearer REPLACE_WITH_YOUR_JWT
Content-Type: application/json

{
  "exerciseId": "REPLACE_EXERCISE_ID"
}

###
# הוספת סט (שמירה תוך כדי)
POST https://progresspulseapplication.onrender.com/api/workouts/sessions/REPLACE_SESSION_ID/exercises/REPLACE_EXERCISE_ID/sets
Authorization: Bearer REPLACE_WITH_YOUR_JWT
Content-Type: application/json

{
  "reps": 10,
  "weight": 40
}

###
# עדכון סט מס' 1 (שמירה תוך כדי)
PUT https://progresspulseapplication.onrender.com/api/workouts/sessions/REPLACE_SESSION_ID/exercises/REPLACE_EXERCISE_ID/sets/1
Authorization: Bearer REPLACE_WITH_YOUR_JWT
Content-Type: application/json

{
  "reps": 8,
  "weight": 45
}

###
# מחיקת סט מס' 1 (שמירה תוך כדי)
DELETE https://progresspulseapplication.onrender.com/api/workouts/sessions/REPLACE_SESSION_ID/exercises/REPLACE_EXERCISE_ID/sets/1
Authorization: Bearer REPLACE_WITH_YOUR_JWT

###
# סגירת סשן (Finish Workout)
POST https://progresspulseapplication.onrender.com/api/workouts/sessions/REPLACE_SESSION_ID/close
Authorization: Bearer REPLACE_WITH_YOUR_JWT

###
# היסטוריית אימונים (עם עמודיות וסינונים אופציונליים)
GET https://progresspulseapplication.onrender.com/api/workouts/history?limit=20&skip=0&from=2025-09-01&to=2025-09-30
Authorization: Bearer REPLACE_WITH_YOUR_JWT

###
# שליפת אימון סגור לפי מזהה
GET https://progresspulseapplication.onrender.com/api/workouts/history/REPLACE_WORKOUT_ID
Authorization: Bearer REPLACE_WITH_YOUR_JWT
