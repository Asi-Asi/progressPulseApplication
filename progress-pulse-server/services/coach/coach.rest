# הדבק כאן את ה-JWT של המאמן אחרי התחברות (כולל הקידומת "Bearer ")
@coachToken = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI2OGQ1MWU0NTZhNjE3ZDc5MmViYWQ2M2EiLCJybHYiOjMwLCJlbWFpbCI6InRlc3Q3MDFAZXhhbXBsZS5jb20iLCJpYXQiOjE3NTg4NDEzNzUsImV4cCI6MTc1ODg0MjI3NX0.rqfR21ke5PogJoa5oXdl_SbFA87Fq9WwRWckXgkP-Os

